# Copy this file to .env, then set a private local password before starting Compose.
# For local HTTP on localhost only, add ASPNETCORE_ENVIRONMENT=Development to .env.
POSTGRES_DB=goulash
POSTGRES_USER=goulash
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000
# Keep local development services reachable only from this computer.
POSTGRES_BIND=127.0.0.1
API_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-random-characters
AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Production HTTPS: point this public DNS name at the host and open ports 80/443.
APP_DOMAIN=app.example.org
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
