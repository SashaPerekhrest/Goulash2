# Copy this file to .env, then set a private local password before starting Compose.
# For local HTTP on localhost only, add ASPNETCORE_ENVIRONMENT=Development to .env.
POSTGRES_DB=goulash
POSTGRES_USER=goulash
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-random-characters
AI_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AI_PROVIDER_TIMEOUT_SECONDS=45
