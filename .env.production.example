# Copy to /opt/goulash2/.env on the server. Never commit the filled-in file.
GHCR_OWNER=your-github-owner-lowercase
# Workflow overrides this with the exact commit SHA. Use a SHA for manual rollback.
IMAGE_TAG=latest
FRONTEND_PORT=3001
# Keep Production for HTTPS. Development permits HTTP cookies without transport encryption.
ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=goulash2
POSTGRES_USER=goulash2
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-random-characters
# Base64 encoding of exactly 32 random bytes; keep a secure backup of this key.
AI_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
